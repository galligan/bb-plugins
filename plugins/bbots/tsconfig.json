{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "lib": ["ES2022", "DOM"],
    "jsx": "react-jsx",
    "types": ["node"],
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": [
    "server.ts",
    "lib",
    "host.ts",
    "app.tsx",
    "components",
    "tests",
    "vitest.config.ts"
  ]
}
