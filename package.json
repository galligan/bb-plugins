{
  "name": "@galligan/bb-plugins-workspace",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "plugins/*"
  ],
  "scripts": {
    "repos": "bun scripts/repos.mjs",
    "build": "bun --filter '!bb-plugin-linear' build",
    "check": "bun --filter '!bb-plugin-linear' check",
    "test": "bun --filter '!bb-plugin-linear' test && bun test scripts/repos.test.mjs",
    "lint": "oxlint plugins scripts --ignore-pattern 'plugins/linear/**' --deny-warnings",
    "format": "prettier . --write",
    "format:check": "prettier . --check"
  },
  "devDependencies": {
    "oxlint": "1.85.0",
    "prettier": "^3.6.2"
  }
}
