{
  "name": "@galligan/bb-plugins-workspace",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "plugins/*"
  ],
  "scripts": {
    "repos": "bun scripts/repos.mjs",
    "build": "bun --filter 'bb-plugin-*' build",
    "check": "bun --filter 'bb-plugin-*' check",
    "test": "bun --filter 'bb-plugin-*' test && bun test ./scripts/*.test.mjs",
    "lint": "oxlint plugins scripts --deny-warnings",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "verify": "bun scripts/verify.mjs",
    "lint:workflows": "bun scripts/lint-workflows.mjs"
  },
  "devDependencies": {
    "oxlint": "1.85.0",
    "prettier": "^3.6.2",
    "@get-bb/plugin-sdk": "0.6.138"
  }
}
